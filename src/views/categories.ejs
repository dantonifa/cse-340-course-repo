<%- include('./partials/header') %>

<main>
    <h1><%= title %></h1>
        
    <% if (locals.user && locals.user.role_id === 2) { %>
        <a href="/categories/new">Create a New Category</a>
    <% } %>

    <!-- Main Categories Content -->
    <h2>Project Categories</h2>
    <p>Browse student projects by academic field and discipline:</p>

    <ul class="categories-list">
                <% categories.forEach(category => { %>
            <li>
                <!-- Category name points to its specific details view -->
                <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
                
                <!-- Edit link points to the management form -->
                <% if (locals.user && locals.user.role_id === 2) { %>
                    <a href="/edit-category/<%= category.category_id %>">Edit</a>
                <% } %>

            </li>
        <% }) %>

    </ul>
</main>

<%- include('./partials/footer') %>
