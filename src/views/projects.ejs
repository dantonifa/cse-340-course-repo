<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our ongoing projects:</p>
    <p><a href="/new-project">Add a New Service Project</a></p>
    <ul class="projects-list">
  <% if (projects && projects.length > 0) { %>
    <% projects.forEach(project => { %>
      <li>
        <strong><%= project.title %></strong>
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organized by:</strong> <%= project.organization_name %></p>
        <p><strong>Categories:</strong> <%= project.categories ? project.categories.join(', ') : 'None' %></p>
        <p><a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a></p>

        <!-- Volunteer Action Section -->
        <% if (locals.user) { %>
            <div class="volunteer-actions" style="margin-top: 10px;">
                <% if (project.isVolunteering) { %>
                    <span class="status-badge" style="color: green; font-weight: bold; display: block; margin-bottom: 5px;">✓ You are volunteering</span>
                    <a href="/projects/<%= project.project_id %>/leave" class="btn-leave" style="color: red;">Remove Yourself as Volunteer</a>
                <% } else { %>
                    <a href="/projects/<%= project.project_id %>/join" class="btn-join" style="color: blue; font-weight: bold;">Volunteer for this Project</a>
                <% } %>
            </div>
        <% } %>

      </li>
    <% }) %>
  <% } else { %>
    <li>No upcoming projects found.</li>
  <% } %>
</ul>

</main>
<%- include('partials/footer') %>

