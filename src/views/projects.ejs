<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our ongoing projects:</p>
    <% if (locals.accountData && locals.accountData.account_type === 'Admin') { %>
        <p><a href="/new-project">Add a New Service Project</a></p>
    <% } %>

    <ul class="projects-list">
    <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <li>
                <!-- Link the project title to its details page -->
                <a href="/project/<%= project.project_id %>">
                    <strong><%= project.title %></strong>
                </a>
                <p><%= project.description %></p>
                <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><strong>Organized by:</strong> <%= project.organization_name %></p>
                <p><strong>Categories:</strong> <%= project.categories ? project.categories.join(', ') : 'None' %></p>
                <% if (locals.accountData && locals.accountData.account_type === 'Admin') { %>
                    <a href="/projects/edit/<%= project.project_id %>" style="color: #e67e22; display: block; margin-bottom: 5px; font-weight: bold;">Edit Project</a>
                    <a href="/projects/<%= project.project_id %>/assign-categories">Edit Categories</a>
                <% } %>

                <!-- Volunteer Action Section -->
        <% if (locals.user) { %>
            <div class="volunteer-actions" style="margin-top: 10px;">
                <!-- 1. Change line 23 to use your volunteeredProjectIds array lookup -->
                <% if (volunteeredProjectIds.includes(project.project_id)) { %>
                <span class="status-badge" style="color: green; font-weight: bold; display: block; margin-bottom: 5px;">
                    ✓ You are volunteering for this project
                </span>
                <form action="/projects/volunteer/remove/<%= project.project_id %>" method="POST">
                    <button type="submit" class="btn-leave" style="color: red; background: none; border: none; padding: 0; font: inherit; cursor: pointer;">
                        Remove Yourself as Volunteer
                    </button>
                </form>
                <% } else { %>
                    <form action="/projects/volunteer/add/<%= project.project_id %>" method="POST">
                        <button type="submit" class="btn-join" style="color: blue; font-weight: bold; background: none; border: none; padding: 0; font: inherit; cursor: pointer;">
                            Volunteer for this Project
                        </button>
                    </form>
                <% } %>

            </div>
        <% } %>
      </li>
    <% }) %>
  <% } else { %>
    <li>No upcoming projects found.</li>
  <% } %>

</ul>

</main>
<%- include('partials/footer') %>

