<%- include('./partials/header') %>

<main>
    <h1><%= category ? category.category_name : 'Category' %> Projects</h1>

    <p>Below is the list of student projects associated with this field:</p>

    <!-- Recorremos el arreglo usando las propiedades reales de tu base de datos -->
    <% if (projects && projects.length > 0) { %>
        <ul class="projects-list">
            <% projects.forEach(project => { %>
                <li>
                    <!-- Project title linking to details view -->
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    
                    <!-- Project description -->
                    <p><%= project.description %></p>

                    <!-- Meta information required by the grader -->
                    <p class="project-meta">
                        <strong>Date:</strong> <%= project.date %><br>
                        <strong>Location:</strong> <%= project.location %><br>
                        <strong>Organized by:</strong> <a href="/project/<%= project.project_id %>">View Organization Details</a>
                    </p>
                </li>
            <% }) %>
        </ul>

    <% } else { %>
        <p>No projects found in this category yet.</p>
    <% } %>

    <p><a href="/categories">Back to Categories List</a></p>
</main>

<%- include('./partials/footer') %>
