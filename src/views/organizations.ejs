<%- include('partials/header') %>
<main>
  <div class="organizations-container">
    <% if (organizations && organizations.length > 0) { %>
      <% organizations.forEach(organization => { %>
        <div class="organization-card">
          <!-- Render the respective logos for b_builders, harvest, u_serve, and for the other organizations use placeholder -->
          <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.organization_name || organization.name %></a></h2>
                        <img src="/images/<%= organization.logo_filename %>" 
             onerror="this.onerror=null; this.src='/images/placeholder-logo.png';" 
             alt="Logo of <%= organization.organization_name || organization.name %>">
          <p><%= organization.organization_description || organization.description %></p>
          <p><strong>Contact: </strong><%= organization.organization_email || organization.email || organization.contact_email %></p>
            <% if (user && user.role_id === 2) { %>
              <p><a href="/edit-organization/<%= organization.organization_id %>">Edit</a></p>
            <% } %>

        </div>
      <% }) %>
    <% } else { %>
         <a href="/organizations" class="btn">Return to Organizations</a>
    <% } %>
  </div>

  <!-- Add a link to the new organization form -->
  <!-- Only administrators can see the add organization button -->
  <!-- Only administrators can see the add organization button -->
  <!-- Only administrators can see the add organization button -->
    <% if (user && user.role_id === 2) { %>
        <p><a href="/new-organization">Add a new organization</a></p>
    <% } %>



</main>
<%- include('partials/footer') %>

  


